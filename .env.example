# Cloudflare Pages & Functions Secrets (configure in Cloudflare Dashboard or frontend/.dev.vars)
APP_ENV=development
COOKIE_SECURE=false
APP_SECRET_KEY=
GEMINI_API_KEY=
# Optional Google sign-in (OAuth "Web application" client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKUP_ENCRYPTION_KEY=
BACKUP_DROP_THRESHOLD_PERCENT=20

# Optional override if frontend talks to an external API origin
VITE_API_BASE_URL=/api/v1
