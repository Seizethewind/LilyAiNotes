{
  "name": "lilyaidatanotes-frontend",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev --port 3000 --host",
    "pages:dev": "npm run build && wrangler pages dev ./build/client --port 8788",
    "pages:deploy": "npm run build && wrangler pages deploy ./build/client",
    "db:migrate:local": "wrangler d1 migrations apply lilyaidatanotes-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lilyaidatanotes-db --remote",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"functions/**/*.{ts,tsx}\" \"workers/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "start": "remix-serve ./build/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@remix-run/cloudflare": "^2.17.5",
    "@remix-run/cloudflare-pages": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "isbot": "^4.4.0",
    "lucide-react": "^0.475.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@eslint/js": "^9.16.0",
    "@remix-run/dev": "^2.17.5",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.16.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.114.17"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
